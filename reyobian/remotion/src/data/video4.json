: 21.659, "text": "dan telat berubah."}, {"t0": 21.779, "t1": 22.963, "text": "Pangsa pasarnya anjlok."}, {"t0": 22.963, "t1": 24.113, "text": "Tahun 2013,"}, {"t0": 24.113, "t1": 25.694, "text": "bisnis HP-nya dijual ke Microsoft."}, {"t0": 26.214, "t1": 27.361, "text": "Tapi Nokia enggak mati."}, {"t0": 27.361, "t1": 28.915, "text": "Mereka pindah ke bisnis jaringan."}, {"t0": 28.915, "t1": 31.483, "text": "Sekarang, sinyal 4G dan 5G yang kamu pakai"}, {"t0": 31.483, "t1": 32.71, "text": "bisa jadi lewat perangkat Nokia."}, {"t0": 33.33, "t1": 34.137, "text": "Pelajarannya:"}, {"t0": 34.137, "t1": 35.659, "text": "yang bikin jatuh itu terlalu nyaman,"}, {"t0": 35.659, "t1": 37.194, "text": "yang bikin bangkit itu berani berubah."}, {"t0": 37.194, "t1": 38.249, "text": "Coba tanya diri kamu:"}, {"t0": 38.249, "t1": 40.125, "text": "skill apa yang mungkin enggak kepakai 5 tahun lagi?"}, {"t0": 40.125, "t1": 41.647, "text": "Mulai pelajari 1 hal baru minggu ini."}, {"t0": 42.067, "t1": 43.609, "text": "HP Nokia pertama kamu tipe apa?"}, {"t0": 43.609, "t1": 44.344, "text": "Tulis di komentar!"}, {"t0": 44.464, "t1": 46.033, "text": "Follow buat info teknologi sehari-hari!"}]}