": 20.555, "text": "sampai berubah jadi aplikasi chat."}, {"t0": 20.555, "t1": 21.224, "text": "Simpel,"}, {"t0": 21.224, "t1": 22.008, "text": "tanpa iklan,"}, {"t0": 22.008, "t1": 22.767, "text": "dan hemat kuota."}, {"t0": 23.187, "t1": 24.369, "text": "Tahun 2014,"}, {"t0": 24.369, "t1": 26.538, "text": "Facebook membelinya seharga 19 miliar dolar."}, {"t0": 26.538, "t1": 28.661, "text": "Sekarang, penggunanya lebih dari 2 miliar orang."}, {"t0": 29.281, "t1": 30.104, "text": "Pelajarannya:"}, {"t0": 30.104, "t1": 31.32, "text": "ditolak itu bukan akhir."}, {"t0": 31.32, "t1": 32.362, "text": "Kalau kamu baru ditolak,"}, {"t0": 32.362, "t1": 33.85, "text": "entah kerjaan, ide, atau usaha,"}, {"t0": 33.85, "t1": 36.251, "text": "catat 1 hal yang bisa diperbaiki,"}, {"t0": 36.251, "t1": 36.918, "text": "lalu coba lagi."}, {"t0": 37.338, "t1": 38.275, "text": "Kamu pernah ditolak,"}, {"t0": 38.275, "t1": 39.769, "text": "tapi akhirnya malah dapat yang lebih baik?"}, {"t0": 39.769, "t1": 40.541, "text": "Cerita di komentar!"}, {"t0": 40.661, "t1": 42.23, "text": "Follow buat info teknologi sehari-hari!"}]}